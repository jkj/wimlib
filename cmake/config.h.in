/* Generated by our build — the equivalent of what wimlib's configure writes.
 *
 * Every entry below is one check from upstream's configure.ac, in the order that
 * file makes them, so the two can be read side by side on a version bump. The
 * sources include this file whenever HAVE_CONFIG_H is defined, which our build
 * always does.
 *
 * WITH_NTFS_3G and WITH_FUSE are deliberately absent rather than defined to 0:
 * both are #ifdef-tested, and both are libraries this build must not link (the
 * licence reasoning is at the top of CMakeLists.txt). ENABLE_TEST_SUPPORT is absent
 * for the same reason — it exists for upstream's own fuzzing harness.
 */
#cmakedefine HAVE_FUTIMENS 1
#cmakedefine HAVE_UTIMENSAT 1
#cmakedefine HAVE_FLOCK 1
#cmakedefine HAVE_MEMPCPY 1
#cmakedefine HAVE_OPENAT 1
#cmakedefine HAVE_FSTATAT 1
#cmakedefine HAVE_READLINKAT 1
#cmakedefine HAVE_FDOPENDIR 1
#cmakedefine HAVE_POSIX_FALLOCATE 1
#cmakedefine HAVE_LLISTXATTR 1
#cmakedefine HAVE_LGETXATTR 1
#cmakedefine HAVE_FSETXATTR 1
#cmakedefine HAVE_LSETXATTR 1
#cmakedefine HAVE_GETOPT_LONG_ONLY 1

#cmakedefine HAVE_ALLOCA_H 1
#cmakedefine HAVE_BYTESWAP_H 1
#cmakedefine HAVE_ENDIAN_H 1
#cmakedefine HAVE_ERRNO_H 1
#cmakedefine HAVE_GLOB_H 1
#cmakedefine HAVE_MACHINE_ENDIAN_H 1
#cmakedefine HAVE_STDARG_H 1
#cmakedefine HAVE_STDDEF_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_SYS_BYTEORDER_H 1
#cmakedefine HAVE_SYS_ENDIAN_H 1
#cmakedefine HAVE_SYS_FILE_H 1
#cmakedefine HAVE_SYS_SYSCALL_H 1
#cmakedefine HAVE_SYS_SYSCTL_H 1
#cmakedefine HAVE_SYS_TIME_H 1
#cmakedefine HAVE_SYS_TIMES_H 1
#cmakedefine HAVE_SYS_XATTR_H 1
#cmakedefine HAVE_TIME_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_UTIME_H 1

/* Whether stat() reports timestamps as struct timespec (st_mtim) rather than
 * whole seconds. macOS spells the member st_mtimespec, so this is correctly off
 * there and wimlib falls back to second precision. */
#cmakedefine HAVE_STAT_NANOSECOND_PRECISION 1

#cmakedefine WORDS_BIGENDIAN 1

/* AC_INIT's two substitutions. The version is what wimlib_get_version_string()
 * returns; the address is printed by its error paths. */
#define PACKAGE_VERSION   "@NCOMM_WIMLIB_VERSION@"
#define PACKAGE_BUGREPORT "@NCOMM_WIMLIB_BUGREPORT@"
